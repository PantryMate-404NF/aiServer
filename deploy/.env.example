# cp .env.example .env  후 필요한 값만 수정

# ── 로컬 컨테이너 (개발용) ─────────────────────────────────────
POSTGRES_USER=reco
POSTGRES_PASSWORD=reco
POSTGRES_DB=recodb
POSTGRES_PORT=5432

REDIS_PORT=6379
MLFLOW_PORT=5000
GRAFANA_PORT=3000
API_PORT=8000
DASHBOARD_PORT=8501

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 접속 문자열 ────────────────────────────────────────────────
# 스키마 네임스페이스는 reco. 역할 수준 search_path 가 설정되지만,
# 슈퍼유저(reco)로 붙을 때를 대비해 options 로도 명시한다.
DATABASE_URL=postgresql://reco:reco@localhost:5432/recodb?options=-csearch_path%3Dreco,public

# ── 공용 원격 DB 로 전환할 때 (2단 구성) ────────────────────────
# 아래 한 줄만 바꾸면 된다. 나머지 설정은 그대로.
#   1) DB 관리자가 ./db/apply_schema.sh 로 스키마 적용
#   2) DATABASE_URL 을 원격으로 교체
#   3) 배치 작업은 reco_batch, 앱은 reco_app 계정 사용
#
# DATABASE_URL=postgresql://reco_app:PASSWORD@db.example.ac.kr:5432/recodb?options=-csearch_path%3Dreco,public
# BATCH_DATABASE_URL=postgresql://reco_batch:PASSWORD@db.example.ac.kr:5432/recodb?options=-csearch_path%3Dreco,public

# Grafana 가 쓰는 읽기 전용 계정 (05_roles.sql 이 생성)
GRAFANA_DB_USER=reco_ro
GRAFANA_DB_PASSWORD=reco_ro_dev
