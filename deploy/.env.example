# cp .env.example .env  후 필요한 값만 수정
#
# 🔴 값을 적지 않습니다. 키 이름만 둡니다 (03 의 2절).
#    비밀값이 아니어도 GitHub 비밀 스캐너가 password=admin 같은 문자열을 잡아
#    알림을 보냅니다. 그리고 여기 적힌 값은 한 번 커밋되면 히스토리에 남습니다.
#
#    비워도 동작합니다. docker-compose.yml 이 모든 변수에 기본값을 갖고 있어서
#    (${POSTGRES_PASSWORD:-reco} 형태) .env 가 비어도 로컬 컨테이너가 뜹니다.
#    각자 필요한 값만 .env 에 적어 덮어씁니다.

# ── 로컬 컨테이너 (개발용) ─────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

REDIS_PORT=
MLFLOW_PORT=
GRAFANA_PORT=
API_PORT=
DASHBOARD_PORT=

GRAFANA_USER=
GRAFANA_PASSWORD=

# ── 접속 문자열 ────────────────────────────────────────────────
# 스키마 네임스페이스는 reco. 역할 수준 search_path 가 설정되지만,
# 슈퍼유저(reco)로 붙을 때를 대비해 options 로도 명시한다.
DATABASE_URL=

# ── 공용 원격 DB 로 전환할 때 (2단 구성) ────────────────────────
# 아래 한 줄만 바꾸면 된다. 나머지 설정은 그대로.
#   1) DB 관리자가 ./db/apply_schema.sh 로 스키마 적용
#   2) DATABASE_URL 을 원격으로 교체
#   3) 배치 작업은 reco_batch, 앱은 reco_app 계정 사용
#
# DATABASE_URL=postgresql://reco_app:PASSWORD@db.example.ac.kr:5432/recodb?options=-csearch_path%3Dreco,public
# BATCH_DATABASE_URL=postgresql://reco_batch:PASSWORD@db.example.ac.kr:5432/recodb?options=-csearch_path%3Dreco,public

# Grafana 가 쓰는 읽기 전용 계정 (deploy/init/05_roles.sql 이 생성합니다)
GRAFANA_DB_USER=
GRAFANA_DB_PASSWORD=
