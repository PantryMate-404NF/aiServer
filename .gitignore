# 비밀값 — 절대 커밋하지 않습니다 (01_DEVELOPMENT_RULES.md 2.4)
.env
.env.*
!.env.example
*.pem
*.key

# 로컬 산출물과 모델 가중치 (02_DIRECTORY_STRUCTURE.md 3.3)
# 폴더는 커밋해 클론 직후에도 존재하게 하고, 안의 파일은 전부 제외합니다.
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# 파이썬
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 가상환경
.venv/
venv/

# 에이전트 도구의 세션 상태와 리플레이 로그
.omc/

# 도구 캐시와 리포트
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# uv.lock 은 반드시 커밋합니다. 여기에 추가하지 않습니다.

# ─────────────────────────────────────────────────────────────
# 추천 파트 (09-04 구조 이식 시 합침)
# ─────────────────────────────────────────────────────────────

# 🔴 크롤 원본 209MB. GitHub 파일 한도(100MB)를 넘어 push 가 거부되고,
#    reviews 에 작성자 닉네임 평문 177,318종이 들어 있다. DB 가 author_hash 로
#    가리는 바로 그 값의 원본이라, 올라가면 REVIEW_SALT 를 지키는 의미가 사라진다.
#    받는 곳은 raw_data/README.md.
# 🔴 디렉터리째 제외하면(/raw_data/) 안쪽 README 를 '!' 로 되살릴 수 없다 —
#    git 이 제외된 디렉터리 내부를 훑지 않기 때문이다. 그래서 /* 로 쓴다.
/raw_data/*
!/raw_data/README.md

# 컨테이너 설정 (비밀값)
deploy/.env

# 작업용 임시 폴더
/scratchpad/

# 실험 추적 · 산출물
/artifacts/
/mlruns/

# 모델 가중치
*.bin
*.safetensors

# OS · IDE
.DS_Store
.idea/
.vscode/

# bench 산출물(scripts/reco/bench/out/)은 **커밋한다.**
# 원본 209MB 는 각자 팀 채널에서 받아 두므로 재생성 자체는 가능하다.
# 그럼에도 커밋하는 이유는 이것이 **문서가 인용하는 수치의 기준선**이기 때문이다 —
# 재료 사전이나 매칭 규칙을 고쳤을 때 무엇이 달라졌는지 diff 로 보려면
# 이전 결과가 저장소에 있어야 한다. 없으면 "예전엔 얼마였지" 를 아무도 모른다.

# ─────────────────────────────────────────────────────────────
# 추천 파트 설계 문서 — 저장소에 올리지 않는다 (09-08)
#
# 팀 저장소에는 기능 개발 코드만 둔다. 설계 노트·초안 아카이브·결정 기록은
# 로컬과 팀 채널에 두고 여기서는 추적하지 않는다.
# 🔴 파일은 디스크에 그대로 있다. 지운 것이 아니라 git 이 잊게 한 것이다.
#
# 데이터 파트가 남에게 넘기는 계약은 문서가 아니라 코드와 DDL 에 있다 —
# recipe_feature 컬럼은 deploy/init/02_schema.sql,
# flavor_vec 산출은 src/features/recommend/ingest/flavor.py 다.
# ─────────────────────────────────────────────────────────────
/docs/reco/
