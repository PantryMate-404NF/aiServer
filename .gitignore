# 비밀값 — 절대 커밋하지 않습니다 (01_DEVELOPMENT_RULES.md 2.4)
.env
.env.*
!.env.example
*.pem
*.key

# 로컬 산출물과 모델 가중치 (02_DIRECTORY_STRUCTURE.md 3.3)
# 폴더는 커밋해 클론 직후에도 존재하게 하고, 안의 파일은 전부 제외합니다.
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# 파이썬
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 가상환경
.venv/
venv/

# 에이전트 도구의 세션 상태와 리플레이 로그
.omc/

# 도구 캐시와 리포트
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# uv.lock 은 반드시 커밋합니다. 여기에 추가하지 않습니다.

# ─────────────────────────────────────────────────────────────
# 추천 파트 (09-04 구조 이식 시 합침)
# ─────────────────────────────────────────────────────────────

# 🔴 크롤 원본 209MB. GitHub 파일 한도(100MB)를 넘어 push 가 거부되고,
#    reviews 에 작성자 닉네임 평문 177,318종이 들어 있다. DB 가 author_hash 로
#    가리는 바로 그 값의 원본이라, 올라가면 REVIEW_SALT 를 지키는 의미가 사라진다.
#    받는 곳은 raw_data/README.md.
# 🔴 디렉터리째 제외하면(/raw_data/) 안쪽 README 를 '!' 로 되살릴 수 없다 —
#    git 이 제외된 디렉터리 내부를 훑지 않기 때문이다. 그래서 /* 로 쓴다.
/raw_data/*
!/raw_data/README.md

# 컨테이너 설정 (비밀값)
deploy/.env

# 작업용 임시 폴더
/scratchpad/

# 실험 추적 · 산출물
/artifacts/
/mlruns/

# 모델 가중치
*.bin
*.safetensors

# OS · IDE
.DS_Store
.idea/
.vscode/

# bench 산출물은 **커밋한다.** raw_data(209MB, 미커밋)로만 재생성되므로
# 받는 사람이 다시 만들 수 없다. 문서가 인용하는 수치의 출처다.
