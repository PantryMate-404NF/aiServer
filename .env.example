# 값은 팀 비밀 저장소에서 개별 수령합니다. 이 파일에는 키 이름만 둡니다.
# 새 환경변수를 추가하면 같은 커밋에서 이 파일을 갱신합니다.

# 데이터베이스
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 애플리케이션
LOG_LEVEL=
INTERNAL_API_KEY=

# 백엔드 연동 — 추천의 실서빙 (docs/env_variables.md 3.4)
# BACKEND_BASE_URL 이 있으면 실서빙, 비어 있으면 목업이 답합니다.
BACKEND_BASE_URL=
# 취향 원본과 추천 로그를 두는 폴더. 기본값이 있으므로 바꿀 때만 주석을 풉니다.
# 컨테이너에서는 지속 볼륨을 /app/var 에 붙이면 둘 다 기본값 그대로 됩니다.
# PROFILE_STORE_DIR=var/profiles
# RECO_LOG_DIR=var/reco_logs

# 영수증 OCR
OCR_WORKERS=
MAX_UPLOAD_BYTES=
MAX_RECEIPT_ID_LENGTH=
OCR_MAX_PIXELS=
OCR_CLAHE_CLIP_LIMIT=
OCR_CLAHE_TILE_GRID=
OCR_SAME_LINE_HEIGHT_RATIO=
OCR_WARMUP_HOLD_SEC=

# 후처리 LLM
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_SEC=
LLM_MAX_RETRIES=
LLM_BACKOFF_BASE_SEC=
RECEIPT_PROMPT_VERSION=
